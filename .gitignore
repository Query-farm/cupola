# build output
dist/
# ...except the vendored Perspective artifacts. They deliberately mirror the npm
# package layout (<pkg>/dist/cdn + <pkg>/dist/wasm) because each bundle locates
# its siblings relative to its own URL — perspective.js rewrites
# `client/dist/cdn` to `server/dist/wasm`, and perspective-viewer.js fetches
# `../wasm/...`. That puts every one of them under a `dist/` directory, which the
# blanket rule above would swallow: `git status` would show only the deletion of
# the old flat files and none of their replacements. Re-include the directories
# first — git cannot re-include a file whose parent directory is excluded.
!public/perspective/**/dist/
!public/perspective/**/dist/**
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# DuckDB-WASM binaries (symlinked from wasm-upgrades build)
public/duckdb/*.wasm
public/duckdb/*.js
public/duckdb/extensions/
public/shell/wasm/
public/shell/extensions/

# Wrangler state
.wrangler/
.worker-build/

# Playwright MCP test artifacts
.playwright-mcp/
/*.png

# Playwright test artifacts
test-results/
