{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    // Vendored, minified third-party bundles (Perspective, DuckDB-WASM shell
    // artifacts) served as static assets. They are fetched by runtime URL —
    // see getPerspectiveCDN() in DuckDBShell — never statically imported, so
    // they contribute nothing to type safety. Checking them produced 170 of
    // the project's 244 diagnostics, all unfixable without hand-editing
    // minified vendor code, which drowned out our own.
    "public"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // No `baseUrl`: it is deprecated in TypeScript 6 and makes a plain `tsc`
    // run fail with TS5101 before it checks a single file. `paths` resolves
    // relative to this file's directory without it.
    "paths": {
      "@/*": ["./src/*"],
      // Mirrors `vite.resolve.dedupe`: pin every importer to this project's
      // single Arrow install, so `Field` is one nominal type across the client
      // package boundary.
      "@query-farm/apache-arrow": ["./node_modules/@query-farm/apache-arrow"],
      "@query-farm/apache-arrow/*": ["./node_modules/@query-farm/apache-arrow/*"]
    },
    // Unit tests import `bun:test`; without this every test file reports
    // TS2307 and drowns out real findings in `astro check`.
    "types": ["bun-types"]
  }
}
