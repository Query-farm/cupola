---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Report visualization guide — Cupola">
  <main class="guide-shell h-screen overflow-y-auto bg-background text-foreground">
    <header class="guide-nav">
      <a class="brand" href={base} aria-label="Back to Cupola">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>Cupola</span>
      </a>
      <a class="back-link" href={base}>Back to reports <span aria-hidden="true">→</span></a>
    </header>

    <article>
      <section class="hero section-width">
        <div class="hero-copy">
          <p class="eyebrow">Report design guide</p>
          <h1>One humidity reading.<br />More than one useful story.</h1>
          <p class="lede">
            Cupola reports offer compact, composable blocks for the question you are actually
            asking—not just a gallery of chart shapes. Start with <strong>68% humidity</strong>,
            then add only the context that helps someone decide what to do.
          </p>
        </div>

        <div class="hero-reading" aria-label="Example humidity reading: 68 percent, up 4 points since 9 AM">
          <div class="reading-head">
            <span>Glen Allen · Indoor humidity</span>
            <span class="live-dot">Live</span>
          </div>
          <div class="reading-value">68<span>%</span></div>
          <div class="reading-change">↑ 4 pts <span>since 9 AM</span></div>
          <svg class="hero-spark" viewBox="0 0 360 92" role="img" aria-label="Humidity increased through the day">
            <path class="area" d="M2 75 C32 75 42 65 70 68 S111 59 138 62 S176 43 205 49 S245 31 271 39 S318 17 358 22 L358 92 L2 92 Z"></path>
            <path class="line" d="M2 75 C32 75 42 65 70 68 S111 59 138 62 S176 43 205 49 S245 31 271 39 S318 17 358 22"></path>
            <circle cx="358" cy="22" r="5"></circle>
          </svg>
          <div class="time-axis"><span>9 AM</span><span>Now</span></div>
        </div>
      </section>

      <section class="decision section-width" aria-labelledby="choose-heading">
        <p class="eyebrow">Choose by question</p>
        <h2 id="choose-heading">What should the reader learn?</h2>
        <div class="decision-grid">
          <div><span class="decision-number">01</span><strong>What is it now?</strong><p>KPI</p></div>
          <div><span class="decision-number">02</span><strong>Which way is it moving?</strong><p>Sparkline</p></div>
          <div><span class="decision-number">03</span><strong>Is it in range?</strong><p>Bullet</p></div>
          <div><span class="decision-number">04</span><strong>How variable is it?</strong><p>Range dot</p></div>
        </div>
      </section>

      <section class="device-section section-width" aria-labelledby="devices-heading">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Tufte-like devices</p>
            <h2 id="devices-heading">Small graphics, dense with meaning</h2>
          </div>
          <p>
            These blocks favor direct labels, shared scales, restrained decoration, and useful
            comparisons. Each can be generated by the report agent and re-run against fresh data.
          </p>
        </div>

        <div class="device-grid">
          <section class="device-card kpi-card">
            <div class="card-heading"><span class="pill">KPI</span><span>Current state</span></div>
            <div class="mini-kpi">68<span>%</span></div>
            <p class="mini-note positive">↑ 4 pts since 9 AM</p>
            <h3>Make the number unmistakable.</h3>
            <p>Best when the current value and a short comparison are the whole message.</p>
          </section>

          <section class="device-card">
            <div class="card-heading"><span class="pill">Sparkline</span><span>Recent direction</span></div>
            <div class="spark-label"><strong>68%</strong><span>last 12 hours</span></div>
            <svg class="mini-spark" viewBox="0 0 320 86" role="img" aria-label="Humidity trend rising from 58 to 68 percent">
              <path d="M2 66 C30 68 42 57 69 59 S107 52 133 56 S173 35 197 42 S237 26 260 31 S296 17 318 19"></path>
              <circle cx="318" cy="19" r="4"></circle>
            </svg>
            <h3>Put a trend beside a metric.</h3>
            <p>No axes or legend when shape and direction are enough. Ideal for dense dashboards.</p>
          </section>

          <section class="device-card wide-card">
            <div class="card-heading"><span class="pill recommended">Recommended over a gauge</span><span>Actual vs target</span></div>
            <div class="bullet-wrap">
              <div class="bullet-label"><strong>Humidity</strong><span>68% · target 50%</span></div>
              <div class="bullet-chart" role="img" aria-label="Humidity 68 percent, above the example preferred band of 40 to 60 percent and target of 50 percent">
                <div class="bullet-zone zone-low"></div><div class="bullet-zone zone-good"></div><div class="bullet-zone zone-high"></div>
                <div class="bullet-actual" style="width: 68%"></div>
                <div class="bullet-target" style="left: 50%"></div>
              </div>
              <div class="bullet-axis"><span>0%</span><span>Example preferred band 40–60%</span><span>100%</span></div>
            </div>
            <h3>Show value, target, and bands in one line.</h3>
            <p>A bullet block uses space efficiently and makes the comparison more precise than an arc. Bands and targets are defined by the report—not assumed by Cupola.</p>
          </section>

          <section class="device-card wide-card">
            <div class="card-heading"><span class="pill">Range dot</span><span>Variation and context</span></div>
            <div class="range-list" role="img" aria-label="Humidity ranges for three rooms with current readings">
              <div class="range-row"><span>Office</span><div class="range-track"><i style="left: 21%; width: 55%"></i><b style="left: 68%"></b></div><strong>68%</strong></div>
              <div class="range-row"><span>Kitchen</span><div class="range-track"><i style="left: 15%; width: 44%"></i><b style="left: 51%"></b></div><strong>51%</strong></div>
              <div class="range-row"><span>Basement</span><div class="range-track"><i style="left: 38%; width: 49%"></i><b style="left: 79%"></b></div><strong>79%</strong></div>
              <div class="range-scale"><span>30%</span><span>50%</span><span>70%</span><span>90%</span></div>
            </div>
            <h3>Keep the reading attached to its range.</h3>
            <p>Use for daily low/high, uncertainty, benchmarks, or any value that is misleading without its spread.</p>
          </section>

          <section class="device-card">
            <div class="card-heading"><span class="pill">Small multiples</span><span>Many sensors</span></div>
            <div class="multiples" aria-label="Small humidity trend charts for Office, Kitchen, and Basement">
              <div><span>Office</span><svg viewBox="0 0 100 28"><path d="M1 22 L20 19 L40 21 L61 12 L81 14 L99 5"></path></svg></div>
              <div><span>Kitchen</span><svg viewBox="0 0 100 28"><path d="M1 15 L20 19 L40 12 L61 18 L81 11 L99 14"></path></svg></div>
              <div><span>Basement</span><svg viewBox="0 0 100 28"><path d="M1 23 L20 20 L40 17 L61 14 L81 8 L99 4"></path></svg></div>
            </div>
            <h3>Repeat one honest scale.</h3>
            <p>Compare the same measure across rooms, sites, products, or cohorts without overlaying a tangle of lines.</p>
          </section>

          <section class="device-card">
            <div class="card-heading"><span class="pill">Slopegraph</span><span>Two moments</span></div>
            <svg class="slope" viewBox="0 0 320 118" role="img" aria-label="Humidity comparison from 8 AM to 4 PM for three rooms">
              <text x="1" y="12">8 AM</text><text x="319" y="12" text-anchor="end">4 PM</text>
              <path d="M54 75 L266 37"></path><path d="M54 52 L266 67"></path><path d="M54 91 L266 23"></path>
              <text x="48" y="78" text-anchor="end">Office 56</text><text x="272" y="40">68</text>
              <text x="48" y="55" text-anchor="end">Kitchen 62</text><text x="272" y="70">58</text>
              <text x="48" y="94" text-anchor="end">Basement 51</text><text x="272" y="26">72</text>
            </svg>
            <h3>Compare exactly two endpoints.</h3>
            <p>Make direction and rank changes visible. For three or more moments, choose a line chart instead.</p>
          </section>
        </div>
      </section>

      <section class="gauge-section section-width" aria-labelledby="gauge-heading">
        <div class="gauge-copy">
          <p class="eyebrow">A deliberate omission</p>
          <h2 id="gauge-heading">Why not a gauge?</h2>
          <p>
            A radial gauge is familiar, but it spends a large area encoding one number. Cupola does
            not currently offer a declarative gauge block. For most report questions, a KPI,
            sparkline, bullet, or range dot gives the reader more context in less space.
          </p>
          <p class="quiet">If the dial metaphor is essential, an agent can still construct one as a custom Vega-Lite chart—but it should earn the space it takes.</p>
        </div>
        <div class="gauge-compare" aria-label="Space comparison between a radial gauge and bullet chart">
          <div class="gauge-demo">
            <svg viewBox="0 0 180 112"><path class="gauge-bg" d="M24 94 A66 66 0 0 1 156 94"></path><path class="gauge-fill" d="M24 94 A66 66 0 0 1 143 55"></path><text x="90" y="90" text-anchor="middle">68%</text></svg>
            <span>Gauge · one value</span>
          </div>
          <div class="versus">vs.</div>
          <div class="compact-demo">
            <div><strong>68%</strong><span>target 50%</span></div>
            <div class="compact-track"><i></i><b></b></div>
            <span>Bullet · value + target + range</span>
          </div>
        </div>
      </section>

      <section class="toolkit section-width" aria-labelledby="toolkit-heading">
        <div class="section-intro">
          <div><p class="eyebrow">The rest of the toolkit</p><h2 id="toolkit-heading">Use richer blocks when the question grows</h2></div>
          <p>All data-backed blocks keep their SQL, can use report parameters, refresh together, and expose CSV, XLSX, and SQL actions on hover.</p>
        </div>
        <div class="toolkit-grid">
          <div><span>Table</span><p>Exact readings, timestamps, and details worth looking up.</p></div>
          <div><span>Chart</span><p>Free-form Vega-Lite for axes, legends, layers, and richer time series.</p></div>
          <div><span>Map</span><p>Leaflet maps for sensor locations and geographic patterns.</p></div>
          <div><span>Perspective</span><p>Interactive pivoting and exploration when the reader needs to ask follow-ups.</p></div>
          <div><span>Markdown</span><p>Narrative, definitions, links, and images that explain what the numbers mean.</p></div>
          <div><span>Parameters</span><p>Let a reader change location, date range, threshold, category, or other typed inputs.</p></div>
          <div><span>Groups</span><p>Rounded, labeled sections keep related KPIs and charts together—for example, one section per city.</p></div>
          <div><span>Alert backgrounds</span><p>Semantic colors and visible status labels can respond to defined query thresholds without custom code.</p></div>
        </div>
      </section>

      <section class="principles section-width" aria-labelledby="principles-heading">
        <p class="eyebrow">A good report</p>
        <h2 id="principles-heading">Evidence first. Decoration last.</h2>
        <ol>
          <li><span>01</span><div><strong>Lead with the answer.</strong><p>Use a descriptive title such as “Humidity is above the preferred range,” not “Humidity chart.”</p></div></li>
          <li><span>02</span><div><strong>Show the comparison.</strong><p>A number becomes meaningful beside a target, prior period, range, or peer.</p></div></li>
          <li><span>03</span><div><strong>Keep scales honest.</strong><p>Small multiples share scales; slopegraphs use two endpoints; units stay visible.</p></div></li>
          <li><span>04</span><div><strong>Explain the source.</strong><p>Add a short caption for the time window, aggregation, thresholds, and caveats.</p></div></li>
        </ol>
      </section>

      <footer class="guide-footer section-width">
        <div><p class="eyebrow">Ready to build?</p><h2>Tell the report agent the decision you need to make.</h2></div>
        <a href={base}>Open Cupola reports <span aria-hidden="true">→</span></a>
      </footer>
    </article>
  </main>
</Layout>

<style>
  .guide-shell { --guide-accent: hsl(170 59% 37%); --guide-accent-soft: hsl(169 60% 95%); font-family: "Commissioner", sans-serif; }
  .section-width, .guide-nav { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
  .guide-nav { height: 72px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid hsl(var(--border)); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; letter-spacing: -.02em; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; color: white; background: var(--guide-accent); font-family: "Petrona", serif; font-size: 18px; }
  .back-link { color: hsl(var(--muted-foreground)); font-size: 14px; transition: color .2s; }
  .back-link:hover { color: hsl(var(--foreground)); }
  .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(48px, 8vw, 110px); align-items: center; padding-block: clamp(72px, 10vw, 132px); }
  .eyebrow { color: var(--guide-accent); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2 { font-family: "Petrona", serif; letter-spacing: -.045em; line-height: 1.02; }
  h1 { max-width: 720px; margin-top: 14px; font-size: clamp(46px, 6vw, 78px); font-weight: 450; }
  h2 { font-size: clamp(34px, 4vw, 52px); font-weight: 450; }
  .lede { max-width: 650px; margin-top: 24px; color: hsl(var(--muted-foreground)); font-size: clamp(17px, 2vw, 20px); line-height: 1.7; }
  .lede strong { color: hsl(var(--foreground)); font-weight: 600; }
  .hero-reading { position: relative; min-width: 0; padding: 24px 26px 20px; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 22px; background: hsl(var(--card)); box-shadow: 0 30px 70px -44px hsl(var(--foreground) / .45); }
  .reading-head, .time-axis { display: flex; align-items: center; justify-content: space-between; color: hsl(var(--muted-foreground)); font-size: 12px; }
  .live-dot { display: inline-flex; align-items: center; gap: 5px; color: var(--guide-accent); }
  .live-dot::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px hsl(170 59% 37% / .12); }
  .reading-value { margin-top: 18px; font-family: "Petrona", serif; font-size: clamp(64px, 9vw, 96px); font-weight: 400; line-height: 1; letter-spacing: -.06em; }
  .reading-value span, .mini-kpi span { margin-left: 5px; color: hsl(var(--muted-foreground)); font-size: .42em; }
  .reading-change { margin-top: 10px; color: var(--guide-accent); font-size: 13px; font-weight: 650; }
  .reading-change span { color: hsl(var(--muted-foreground)); font-weight: 400; }
  .hero-spark { width: 100%; height: auto; margin-top: 16px; overflow: visible; }
  .hero-spark .area { fill: hsl(170 59% 37% / .09); }
  .hero-spark .line, .mini-spark path { fill: none; stroke: var(--guide-accent); stroke-width: 2; }
  .hero-spark circle, .mini-spark circle { fill: hsl(var(--card)); stroke: var(--guide-accent); stroke-width: 3; }
  .decision { padding-bottom: 100px; }
  .decision h2 { margin-top: 10px; }
  .decision-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 40px; border-block: 1px solid hsl(var(--border)); }
  .decision-grid > div { min-height: 154px; padding: 24px; border-right: 1px solid hsl(var(--border)); }
  .decision-grid > div:first-child { padding-left: 0; }
  .decision-grid > div:last-child { border-right: 0; }
  .decision-number { display: block; margin-bottom: 24px; color: var(--guide-accent); font-family: "JetBrains Mono", monospace; font-size: 11px; }
  .decision-grid strong { display: block; font-family: "Petrona", serif; font-size: 19px; font-weight: 500; }
  .decision-grid p { margin-top: 8px; color: hsl(var(--muted-foreground)); font-size: 13px; }
  .device-section { padding-block: 100px; border-top: 1px solid hsl(var(--border)); }
  .section-intro { display: grid; grid-template-columns: 1.1fr .9fr; gap: 60px; align-items: end; margin-bottom: 44px; }
  .section-intro h2 { max-width: 650px; margin-top: 10px; }
  .section-intro > p { max-width: 490px; color: hsl(var(--muted-foreground)); line-height: 1.7; }
  .device-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .device-card { min-height: 390px; padding: clamp(22px, 3vw, 34px); border: 1px solid hsl(var(--border)); border-radius: 18px; background: hsl(var(--card)); }
  .card-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: hsl(var(--muted-foreground)); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  .pill { display: inline-flex; width: fit-content; padding: 5px 8px; border-radius: 999px; color: var(--guide-accent); background: var(--guide-accent-soft); font-weight: 700; }
  .pill.recommended { letter-spacing: .05em; }
  .device-card h3 { margin-top: 30px; font-family: "Petrona", serif; font-size: 24px; font-weight: 500; letter-spacing: -.02em; }
  .device-card > p:last-child { max-width: 540px; margin-top: 9px; color: hsl(var(--muted-foreground)); font-size: 14px; line-height: 1.6; }
  .mini-kpi { margin-top: 52px; font-family: "Petrona", serif; font-size: 82px; line-height: 1; letter-spacing: -.06em; }
  .mini-note { margin-top: 8px; font-size: 12px; }
  .positive { color: var(--guide-accent); }
  .spark-label { display: flex; align-items: baseline; justify-content: space-between; margin-top: 40px; }
  .spark-label strong { font-family: "Petrona", serif; font-size: 40px; font-weight: 450; }
  .spark-label span { color: hsl(var(--muted-foreground)); font-size: 11px; }
  .mini-spark { width: 100%; margin-top: 8px; overflow: visible; }
  .wide-card { grid-column: span 2; min-height: 360px; }
  .bullet-wrap { margin-top: 48px; }
  .bullet-label { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 13px; }
  .bullet-label span { color: hsl(var(--muted-foreground)); }
  .bullet-chart { position: relative; display: flex; height: 38px; overflow: hidden; background: hsl(var(--muted)); }
  .bullet-zone { height: 100%; }
  .zone-low { width: 40%; background: hsl(var(--muted)); }
  .zone-good { width: 20%; background: hsl(170 59% 37% / .22); }
  .zone-high { width: 40%; background: hsl(var(--muted-foreground) / .14); }
  .bullet-actual { position: absolute; left: 0; top: 12px; height: 14px; background: hsl(var(--foreground) / .84); }
  .bullet-target { position: absolute; top: 5px; width: 3px; height: 28px; background: var(--guide-accent); }
  .bullet-axis { display: flex; justify-content: space-between; margin-top: 8px; color: hsl(var(--muted-foreground)); font-family: "JetBrains Mono", monospace; font-size: 9px; }
  .range-list { display: grid; gap: 18px; margin-top: 42px; }
  .range-row { display: grid; grid-template-columns: 90px 1fr 50px; gap: 14px; align-items: center; font-size: 12px; }
  .range-row > strong { text-align: right; }
  .range-track { position: relative; height: 2px; background: hsl(var(--border)); }
  .range-track i { position: absolute; top: 0; height: 2px; background: hsl(var(--foreground) / .55); }
  .range-track i::before, .range-track i::after { content: ""; position: absolute; top: -3px; width: 8px; height: 8px; border: 1.5px solid hsl(var(--foreground) / .55); border-radius: 50%; background: hsl(var(--card)); }
  .range-track i::before { left: -4px; } .range-track i::after { right: -4px; }
  .range-track b { position: absolute; top: -5px; width: 12px; height: 12px; border: 2px solid hsl(var(--card)); border-radius: 50%; background: var(--guide-accent); box-shadow: 0 0 0 1px var(--guide-accent); }
  .range-scale { display: flex; justify-content: space-between; margin-left: 104px; margin-right: 64px; color: hsl(var(--muted-foreground)); font-family: "JetBrains Mono", monospace; font-size: 9px; }
  .multiples { display: grid; gap: 9px; margin-top: 32px; }
  .multiples > div { display: grid; grid-template-columns: 68px 1fr; gap: 8px; align-items: center; color: hsl(var(--muted-foreground)); font-size: 10px; }
  .multiples svg { width: 100%; border-bottom: 1px solid hsl(var(--border)); }
  .multiples path { fill: none; stroke: var(--guide-accent); stroke-width: 1.5; }
  .slope { width: 100%; margin-top: 28px; overflow: visible; }
  .slope path { fill: none; stroke: hsl(var(--foreground) / .5); stroke-width: 1.5; }
  .slope path:last-of-type { stroke: var(--guide-accent); stroke-width: 2; }
  .slope text { fill: hsl(var(--muted-foreground)); font: 8px "JetBrains Mono", monospace; }
  .gauge-section { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 100px); align-items: center; padding-block: 110px; border-top: 1px solid hsl(var(--border)); }
  .gauge-copy h2 { margin-top: 10px; }
  .gauge-copy > p:not(.eyebrow) { margin-top: 20px; color: hsl(var(--muted-foreground)); line-height: 1.7; }
  .gauge-copy .quiet { font-size: 13px; }
  .gauge-compare { display: grid; grid-template-columns: 1fr auto 1.3fr; align-items: center; gap: 26px; padding: 32px; border-radius: 20px; background: hsl(var(--muted) / .55); }
  .gauge-demo, .compact-demo { display: flex; flex-direction: column; align-items: center; gap: 12px; color: hsl(var(--muted-foreground)); font-size: 10px; text-align: center; }
  .gauge-demo svg { width: 150px; }
  .gauge-bg, .gauge-fill { fill: none; stroke-width: 15; stroke-linecap: butt; }
  .gauge-bg { stroke: hsl(var(--border)); } .gauge-fill { stroke: var(--guide-accent); }
  .gauge-demo text { fill: hsl(var(--foreground)); font: 34px "Petrona", serif; }
  .versus { color: hsl(var(--muted-foreground)); font-family: "Petrona", serif; font-style: italic; }
  .compact-demo { align-items: stretch; min-width: 190px; text-align: left; }
  .compact-demo > div:first-child { display: flex; align-items: baseline; justify-content: space-between; color: hsl(var(--foreground)); }
  .compact-demo strong { font-family: "Petrona", serif; font-size: 34px; font-weight: 450; }
  .compact-demo div span { color: hsl(var(--muted-foreground)); font-size: 10px; }
  .compact-track { position: relative; height: 24px; background: linear-gradient(to right, hsl(var(--border)) 40%, hsl(170 59% 37% / .22) 40% 60%, hsl(var(--muted-foreground) / .16) 60%); }
  .compact-track i { position: absolute; top: 8px; left: 0; width: 68%; height: 8px; background: hsl(var(--foreground) / .85); }
  .compact-track b { position: absolute; top: 3px; left: 50%; width: 2px; height: 18px; background: var(--guide-accent); }
  .toolkit { padding-block: 100px; border-top: 1px solid hsl(var(--border)); }
  .toolkit-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid hsl(var(--border)); border-left: 1px solid hsl(var(--border)); }
  .toolkit-grid > div { min-height: 160px; padding: 26px; border-right: 1px solid hsl(var(--border)); border-bottom: 1px solid hsl(var(--border)); }
  .toolkit-grid span { font-family: "Petrona", serif; font-size: 22px; }
  .toolkit-grid p { margin-top: 12px; color: hsl(var(--muted-foreground)); font-size: 13px; line-height: 1.6; }
  .principles { padding-block: 100px; border-top: 1px solid hsl(var(--border)); }
