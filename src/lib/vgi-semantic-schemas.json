{
  "catalog": {
    "$id": "https://query.farm/schema/vgi/semantic/catalog.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "binding_key": {
        "$ref": "definitions.json#/$defs/semantic_id"
      },
      "catalog_id": {
        "$ref": "definitions.json#/$defs/catalog_id"
      },
      "catalog_instance_id": {
        "$ref": "definitions.json#/$defs/semantic_id"
      },
      "default_timezone": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "description": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "catalog_id"
    ],
    "type": "object"
  },
  "definitions": {
    "$defs": {
      "additivity": {
        "oneOf": [
          {
            "const": "additive"
          },
          {
            "const": "non_additive"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "semi_additive"
              },
              "prohibited_dimensions": {
                "items": {
                  "$ref": "#/$defs/semantic_id"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "kind",
              "prohibited_dimensions"
            ],
            "type": "object"
          }
        ]
      },
      "cardinality": {
        "additionalProperties": false,
        "properties": {
          "max": {
            "enum": [
              1,
              "many"
            ]
          },
          "min": {
            "enum": [
              0,
              1
            ]
          },
          "roles": {
            "items": {
              "$ref": "#/$defs/semantic_id"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "min",
          "max"
        ],
        "type": "object"
      },
      "catalog_id": {
        "$ref": "#/$defs/semantic_id"
      },
      "entity_ref": {
        "additionalProperties": false,
        "properties": {
          "catalog_id": {
            "$ref": "#/$defs/catalog_id"
          },
          "entity_id": {
            "$ref": "#/$defs/semantic_id"
          }
        },
        "required": [
          "catalog_id",
          "entity_id"
        ],
        "type": "object"
      },
      "semantic_id": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "source_argument": {
        "additionalProperties": false,
        "description": "Maps one physical table-function argument to a semantic query parameter. Calling convention and order are inferred from vgi_function_arguments(), never duplicated here.",
        "properties": {
          "argument": {
            "description": "Exact physical argument name reported by vgi_function_arguments().",
            "minLength": 1,
            "type": "string"
          },
          "parameter": {
            "$ref": "#/$defs/semantic_id",
            "description": "Semantic request parameter name."
          },
          "required": {
            "default": true,
            "description": "Whether the semantic request must supply the parameter. False requires a physical function default.",
            "type": "boolean"
          }
        },
        "required": [
          "argument",
          "parameter"
        ],
        "type": "object"
      }
    },
    "$id": "https://query.farm/schema/vgi/semantic/definitions.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "diagnostic": {
    "$id": "https://query.farm/schema/vgi/semantic/diagnostic.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "code": {
        "minLength": 1,
        "type": "string"
      },
      "details": {
        "type": "object"
      },
      "message": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "stage": {
        "enum": [
          "request_validation",
          "model_resolution",
          "multi_fact_not_supported",
          "catalog_binding",
          "relationship_resolution",
          "source_binding",
          "unit_resolution",
          "execution_limit",
          "type_check",
          "fanout",
          "required_filter",
          "sql_generation",
          "duckdb_execution"
        ]
      }
    },
    "required": [
      "stage",
      "code",
      "message"
    ],
    "type": "object"
  },
  "entity": {
    "$id": "https://query.farm/schema/vgi/semantic/entity.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "default_time_dimension": {
        "$ref": "definitions.json#/$defs/semantic_id"
      },
      "description": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "entity_id": {
        "$ref": "definitions.json#/$defs/semantic_id"
      },
      "grain": {
        "items": {
          "$ref": "definitions.json#/$defs/semantic_id"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "source": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "items": {
              "$ref": "definitions.json#/$defs/source_argument"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "type": "object"
      },
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "entity_id",
      "grain"
    ],
    "type": "object"
  },
  "environment": {
    "$id": "https://query.farm/schema/vgi/semantic/environment.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "attachments": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "minLength": 1,
              "type": "string"
            },
            "binding_key": {
              "$ref": "definitions.json#/$defs/semantic_id"
            },
            "catalog_id": {
              "$ref": "definitions.json#/$defs/catalog_id"
            },
            "catalog_instance_id": {
              "$ref": "definitions.json#/$defs/semantic_id"
            }
          },
          "required": [
            "alias",
            "catalog_id"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "attachments"
    ],
    "type": "object"
  },
  "expression": {
    "$defs": {
      "expr": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "member": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "op": {
                "const": "member"
              }
            },
            "required": [
              "op",
              "member"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "literal"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "op",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "left": {
                "$ref": "#/$defs/expr"
              },
              "op": {
                "enum": [
                  "add",
                  "subtract",
                  "multiply",
                  "divide",
                  "safe_divide"
                ]
              },
              "right": {
                "$ref": "#/$defs/expr"
              }
            },
            "required": [
              "op",
              "left",
              "right"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "args": {
                "items": {
                  "$ref": "#/$defs/expr"
                },
                "maxItems": 20,
                "minItems": 1,
                "type": "array"
              },
              "op": {
                "enum": [
                  "coalesce"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "nullif"
              },
              "other": {
                "$ref": "#/$defs/expr"
              },
              "value": {
                "$ref": "#/$defs/expr"
              }
            },
            "required": [
              "op",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "cast"
              },
              "type": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/expr"
              }
            },
            "required": [
              "op",
              "value",
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "else": {
                "$ref": "#/$defs/expr"
              },
              "op": {
                "const": "case"
              },
              "then": {
                "$ref": "#/$defs/expr"
              },
              "when": {
                "$ref": "#/$defs/expr"
              }
            },
            "required": [
              "op",
              "when",
              "then"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$id": "https://query.farm/schema/vgi/semantic/expression.json",
    "$ref": "#/$defs/expr",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "member": {
    "$defs": {
      "base": {
        "properties": {
          "data_type": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "identifier",
              "dimension",
              "time_dimension",
              "measure"
            ]
          },
          "member_id": {
            "$ref": "definitions.json#/$defs/semantic_id"
          },
          "output_type": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "member_id",
          "kind"
        ],
        "type": "object"
      },
      "column_path": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 16,
        "minItems": 2,
        "type": "array"
      },
      "dimension": {
        "allOf": [
          {
            "$ref": "#/$defs/base"
          },
          {
            "additionalProperties": false,
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit",
                    "unit_parameter"
                  ]
                },
                {
                  "required": [
                    "column",
                    "column_path"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "column"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "column_path"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "expression"
                  ]
                }
              ]
            },
            "properties": {
              "column": {
                "minLength": 1,
                "type": "string"
              },
              "column_path": {
                "$ref": "#/$defs/column_path"
              },
              "data_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "expression": {
                "$ref": "expression.json"
              },
              "hidden": {
                "type": "boolean"
              },
              "kind": {
                "const": "dimension"
              },
              "member_id": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "output_type": {
                "type": "string"
              },
              "source_argument": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "type": "string"
              },
              "unit_parameter": {
                "$ref": "#/$defs/unit_parameter"
              }
            },
            "required": [
              "member_id",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "identifier": {
        "allOf": [
          {
            "$ref": "#/$defs/base"
          },
          {
            "additionalProperties": false,
            "not": {
              "required": [
                "column",
                "column_path"
              ]
            },
            "properties": {
              "column": {
                "minLength": 1,
                "type": "string"
              },
              "column_path": {
                "$ref": "#/$defs/column_path"
              },
              "data_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              },
              "kind": {
                "const": "identifier"
              },
              "member_id": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "output_type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "member_id",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "measure": {
        "allOf": [
          {
            "$ref": "#/$defs/base"
          },
          {
            "additionalProperties": false,
            "not": {
              "required": [
                "unit",
                "unit_parameter"
              ]
            },
            "oneOf": [
              {
                "required": [
                  "aggregation"
                ]
              },
              {
                "required": [
                  "expression"
                ]
              }
            ],
            "properties": {
              "additivity": {
                "$ref": "definitions.json#/$defs/additivity"
              },
              "aggregation": {
                "enum": [
                  "count_rows",
                  "count",
                  "count_distinct",
                  "sum",
                  "min",
                  "max",
                  "avg"
                ]
              },
              "data_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "expression": {
                "$ref": "expression.json"
              },
              "hidden": {
                "type": "boolean"
              },
              "kind": {
                "const": "measure"
              },
              "member": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "member_id": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "output_type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "type": "string"
              },
              "unit_parameter": {
                "$ref": "#/$defs/unit_parameter"
              }
            },
            "required": [
              "member_id",
              "kind",
              "additivity"
            ],
            "type": "object"
          }
        ]
      },
      "time_dimension": {
        "allOf": [
          {
            "$ref": "#/$defs/base"
          },
          {
            "additionalProperties": false,
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit",
                    "unit_parameter"
                  ]
                },
                {
                  "required": [
                    "column",
                    "column_path"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "column"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "column_path"
                  ]
                },
                {
                  "required": [
                    "source_argument",
                    "expression"
                  ]
                }
              ]
            },
            "properties": {
              "column": {
                "minLength": 1,
                "type": "string"
              },
              "column_path": {
                "$ref": "#/$defs/column_path"
              },
              "data_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "expression": {
                "$ref": "expression.json"
              },
              "granularities": {
                "items": {
                  "enum": [
                    "minute",
                    "hour",
                    "day",
                    "week",
                    "month",
                    "quarter",
                    "year"
                  ]
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "hidden": {
                "type": "boolean"
              },
              "kind": {
                "const": "time_dimension"
              },
              "member_id": {
                "$ref": "definitions.json#/$defs/semantic_id"
              },
              "output_type": {
                "type": "string"
              },
              "source_argument": {
                "minLength": 1,
                "type": "string"
              },
              "timezone": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "type": "string"
              },
              "unit_parameter": {
                "$ref": "#/$defs/unit_parameter"
              },
              "week_start": {
                "const": "monday"
              }
            },
            "required": [
              "member_id",
              "kind",
              "timezone",
              "granularities"
            ],
            "type": "object"
          }
        ]
      },
      "unit_parameter": {
        "additionalProperties": false,
        "properties": {
          "argument": {
            "minLength": 1,
            "type": "string"
          },
          "values": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "minProperties": 1,
            "propertyNames": {
              "minLength": 1
            },
            "type": "object"
          }
        },
        "required": [
          "argument",
          "values"
        ],
        "type": "object"
      }
    },
    "$id": "https://query.farm/schema/vgi/semantic/member.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "$ref": "#/$defs/identifier"
      },
      {
        "$ref": "#/$defs/dimension"
      },
      {
        "$ref": "#/$defs/time_dimension"
      },
      {
        "$ref": "#/$defs/measure"
      }
    ]
  },
  "member-template": {
    "$defs": {
      "member_patch": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "additivity": {
            "$ref": "definitions.json#/$defs/additivity"
          },
          "aggregation": {
            "enum": [
              "count_rows",
              "count",
              "count_distinct",
              "sum",
              "min",
              "max",
              "avg"
            ]
          },
          "column": {
            "minLength": 1,
            "type": "string"
          },
          "column_path": {
            "$ref": "member.json#/$defs/column_path"
          },
          "data_type": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "expression": {
            "$ref": "expression.json"
          },
          "granularities": {
            "items": {
              "enum": [
                "minute",
                "hour",
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "hidden": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "identifier",
              "dimension",
              "time_dimension",
              "measure"
            ]
          },
          "member": {
            "$ref": "definitions.json#/$defs/semantic_id"
          },
          "member_id": {
            "$ref": "definitions.json#/$defs/semantic_id"
          },
          "output_type": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "source_argument": {
            "minLength": 1,
            "type": "string"
          },
          "timezone": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "unit_parameter": {
            "$ref": "member.json#/$defs/unit_parameter"
          },
          "week_start": {
            "const": "monday"
          }
        },
        "type": "object"
      }
    },
    "$id": "https://query.farm/schema/vgi/semantic/member-template.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "members": {
        "items": {
          "allOf": [
            {
              "$ref": "#/$defs/member_patch"
            },
            {
              "required": [
                "member_id"
              ]
            }
          ]
        },
        "maxItems": 500,
        "minItems": 1,
        "type": "array"
      },
      "template": {
        "$ref": "#/$defs/member_patch",
        "not": {
          "required": [
            "member_id"
          ]
        }
      },
      "template_id": {
        "$ref": "definitions.json#/$defs/semantic_id"
      }
    },
    "required": [
      "template_id",
      "template",
      "members"
    ],
    "type": "object"
  },
  "members": {
    "$id": "https://query.farm/schema/vgi/semantic/members.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "oneOf": [
        {
          "$ref": "member.json"
        },
        {
          "$ref": "member-template.json"
        }
      ]
    },
    "maxItems": 500,
    "type": "array"
  },
  "plan": {
    "$defs": {
      "fact_branch": {
        "additionalProperties": false,
        "properties": {
          "attachment_alias": {
            "type": "string"
          },
          "driver": {
            "type": "object"
          },
          "driving_grain_reduced": {
            "type": "boolean"
          },
          "effective_source_grain": {
            "items": {
              "$ref": "#/$defs/grain_item"
            },
            "type": "array"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "estimated_invocations": {
            "minimum": 0,
            "type": "integer"
          },
          "invocations": {
            "items": {
              "$ref": "#/$defs/invocation"
            },
